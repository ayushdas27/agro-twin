# AGRO-TWIN Environment Configuration Example
# Copy this file to .env and populate with your production values

# Application Environment
ENVIRONMENT=development
PORT=8000

# Backend API URL (for frontend clients)
VITE_BACKEND_URL=http://localhost:8000

# Supabase Configuration (Optional for cloud DB migration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Weather API Integration (Future Phase)
OPENWEATHER_API_KEY=
